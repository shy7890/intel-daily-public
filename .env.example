# Required
INTEL_DB_PATH=/data/intel.db
INTEL_ADMIN_USERNAME=admin
INTEL_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_VALUE_AT_LEAST_12_CHARS
INTEL_PORT=8000

# Optional, shown only as configured/not-configured in the console
# 变量名以 worker 实际读取为准（src/intel_daily/worker.py）：
# INTEL_FEISHU_WEBHOOK=            # 飞书群机器人 webhook，--send/--test-send 使用
# INTEL_AI_API_KEY=               # DeepSeek API key，未配置时降级 Stub 摘要
# INTEL_AI_MODEL=deepseek-chat    # 可选，默认 deepseek-chat
# INTEL_AI_BASE_URL=https://api.deepseek.com   # 可选
